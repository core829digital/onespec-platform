# OneSpec - environment template. Copy to .env.local (Next.js).
# Set Convex-side vars with: npx convex env set <NAME> <value>
# NEVER commit real values.

# --- Next.js (.env.local) ---
NEXT_PUBLIC_CONVEX_URL="https://<deployment>.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://<deployment>.convex.site"
CONVEX_DEPLOYMENT="dev:<deployment>"

# --- Convex deployment (npx convex env set ...) ---
# Auth token signing keys (generate once per deployment with jose):
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"
JWKS='{"keys":[{"use":"sig","kty":"RSA","n":"...","e":"AQAB"}]}'
SITE_URL="http://localhost:3000"
# Marketing site (source of truth of the product version shown in the side menu: GET /api/version). Defaults to https://onespec.eu.
MARKETING_SITE_URL="https://onespec.eu"
NEXT_PUBLIC_MARKETING_SITE_URL="https://onespec.eu"

RESEND_MODE="noop"                 # noop | live
AUTH_RESEND_KEY=""
RESEND_FROM="onespec <onboarding@resend.dev>"

DAILY_IP_SALT=""
TURNSTILE_SECRET=""
ADMIN_EMAILS="contact.core829@gmail.com,office@winex.ro"

# --- Stripe billing (npx convex env set ...) ---
# Price IDs are resolved as STRIPE_PRICE_<BASE|PRO|AGENCY>_<MONTHLY|ANNUAL>_<IT|FR|BE|NL|DE|LU>,
# falling back to STRIPE_PRICE_<PLAN>_<CYCLE>, then (monthly only) the legacy STRIPE_PRICE_BASE / STRIPE_PRICE_PRO.
# Enterprise is sales-led (ad-hoc Price per deal or manual invoice).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Secret path segment of the Stripe webhook URL: https://<deployment>.convex.site/ev/<token>.
# 24-128 chars of [A-Za-z0-9_-]. Without it the webhook route is NOT registered (404).
STRIPE_WEBHOOK_PATH_TOKEN=""
STRIPE_PRICE_BASE_MONTHLY=""
STRIPE_PRICE_BASE_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_AGENCY_MONTHLY=""
STRIPE_PRICE_AGENCY_ANNUAL=""
# Optional per-market override, e.g. STRIPE_PRICE_PRO_ANNUAL_IT="" (same naming, "_<MARKET>" suffix).
# Legacy single-price env (monthly only, fallback during migration):
STRIPE_PRICE_BASE=""
STRIPE_PRICE_PRO=""
# Extra origins (comma-separated) Stripe may return the customer to, besides SITE_URL:
ALLOWED_APP_ORIGINS=""
# Sales contact shown on the Enterprise card:
SALES_EMAIL=""
# Local/dev only: allow onboarding without Stripe configured. Never "1" in production.
ONESPEC_ALLOW_FREE_ONBOARDING=""
# 0 = kill switch for the webhook source-IP check (Stripe/Resend published lists); default enforces.
WEBHOOK_IP_ENFORCE=""

# --- Operations (npx convex env set ...) ---
# Comma-separated recipients for automatic production error alerts (see docs/AVVISI_ERRORI_PRODUZIONE.md).
OPS_ALERT_EMAIL=""
# Resend: sender addresses and delivery-tracking webhook signature secret.
RESEND_FROM_NOREPLY="noreply@onespec.eu"
RESEND_FROM_PURCHASES="purchases@onespec.eu"
RESEND_WEBHOOK_SECRET=""
# Product analytics from the server side (optional; events are skipped when unset).
POSTHOG_HOST=""
POSTHOG_PROJECT_TOKEN=""

# --- Turnstile bot check (Cloudflare) ---
# Server secret (Convex env). When set, widget quote submits REQUIRE a valid token.
# TURNSTILE_SECRET=""
# Public site key (Next.js env). When set, widgets fetch a token before submit.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Convex env: comma-separated hostnames accepted in Turnstile verification (optional hardening).
# TURNSTILE_HOSTNAMES=""
# Convex env: set to 1 to require Turnstile on sign-in/sign-up too (needs TURNSTILE_SECRET).
# TURNSTILE_ENFORCE_AUTH=""
