# OneSpec - environment template. Copy to .env.local (Next.js).
# Set Convex-side vars with: npx convex env set <NAME> <value>
# NEVER commit real values.

# --- Next.js (.env.local) ---
NEXT_PUBLIC_CONVEX_URL="https://<deployment>.convex.cloud"
NEXT_PUBLIC_CONVEX_SITE_URL="https://<deployment>.convex.site"
CONVEX_DEPLOYMENT="dev:<deployment>"

# --- Convex deployment (npx convex env set ...) ---
# Auth token signing keys (generate once per deployment with jose):
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY----- ... -----END PRIVATE KEY-----"
JWKS='{"keys":[{"use":"sig","kty":"RSA","n":"...","e":"AQAB"}]}'
SITE_URL="http://localhost:3000"

RESEND_MODE="noop"                 # noop | live
AUTH_RESEND_KEY=""
RESEND_FROM="onespec <onboarding@resend.dev>"

DAILY_IP_SALT=""
TURNSTILE_SECRET=""
ADMIN_EMAILS="contact.core829@gmail.com"

# --- Stripe billing (npx convex env set ...) ---
# Per-market Price IDs: STRIPE_PRICE_<STARTER|PRO>_<MONTHLY|ANNUAL>_<IT|FR|BE|NL|DE|LU>.
# Enterprise/Showroom are sales-led (ad-hoc Price per deal or manual invoice).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
# Legacy single-price env (monthly only, kept as fallback during migration):
STRIPE_PRICE_BUSINESS=""
# Sales contact shown on the Enterprise/Showroom cards:
SALES_EMAIL=""
# Optional one-time onboarding fees (cents), display-only unless invoiced manually:
STRIPE_SETUP_FEE_ENTERPRISE_CENTS="20000"
STRIPE_SETUP_FEE_SHOWROOM_CENTS="30000"
