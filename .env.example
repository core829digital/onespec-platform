# ─────────────────────────────────────────────────────────────
# Next.js (Vercel) env — copy to .env.local for local dev
# ─────────────────────────────────────────────────────────────
# From `npx convex dev` output:
NEXT_PUBLIC_CONVEX_URL="https://<your-deployment>.convex.cloud"
# Convex HTTP actions live on the .site domain (widget quote endpoint):
NEXT_PUBLIC_CONVEX_SITE_URL="https://<your-deployment>.convex.site"
# Public site URL (no custom domain yet -> vercel.app):
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Cloudflare Turnstile (widget anti-spam) — leave blank to disable in dev:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ─────────────────────────────────────────────────────────────
# Convex deployment env — set with `npx convex env set KEY value`
# (NOT read from this file — listed here for reference)
# ─────────────────────────────────────────────────────────────
# CONVEX_SITE_URL="https://<your-deployment>.convex.site"   # for auth.config.ts
# SITE_URL="http://localhost:3000"                          # email links / logo absolute URL
# ADMIN_EMAILS="contact.core829@gmail.com"                  # comma-separated platform admins
# RESEND_MODE="noop"                                        # "noop" | "live"
# AUTH_RESEND_KEY=""                                        # Resend API key (blank in noop)
# RESEND_FROM="onespec <onboarding@resend.dev>"             # Resend sandbox until domain bought
# DAILY_IP_SALT="change-me"                                 # salt for hashing widget submitter IPs
# TURNSTILE_SECRET=""                                       # Cloudflare Turnstile secret
# RESEND_WEBHOOK_SECRET=""                                  # Svix secret for /api/resend/webhook
